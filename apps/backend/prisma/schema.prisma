// Mowaslaty Egypt — Prisma schema (PostgreSQL)
// Learn more: https://pris.ly/d/prisma-schema
//
// NOTE: the development sandbox uses the in-memory database driver.
// For PostgreSQL: set DATABASE_URL, then `npx prisma migrate deploy` (or db push)
// and `npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= Users & Auth =============
model User {
  id       String    @id @default(cuid())
  email    String    @unique
  password String? // null for non-registered users
  name     String?
  avatar   String?
  role     UserRole  @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites     Favorite[]
  searchHistory SearchHistory[]
  reports       TransitReport[]
  adminLogs     AuditLog[]

  @@index([email])
}

enum UserRole {
  USER
  DATA_ADMIN
  MODERATOR
  SUPER_ADMIN
}

// ============= Geography =============
model City {
  id          String  @id @default(cuid())
  name        String  @unique
  nameAr      String  @unique
  nameEn      String?
  latitude    Float
  longitude   Float
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas  Area[]
  stops  Stop[]
  routes Route[]

  @@index([name])
  @@index([nameAr])
}

model Area {
  id     String  @id @default(cuid())
  name   String
  nameAr String
  nameEn String?
  cityId String
  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops Stop[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([name])
}

// ============= Transit Data =============
model TransportMode {
  id          String  @id @default(cuid())
  name        String  @unique
  nameAr      String  @unique
  icon        String // emoji or icon name
  color       String // hex color
  description String?

  routes Route[]

  @@index([name])
}

model Stop {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  nameEn    String?
  latitude  Float
  longitude Float
  address   String?
  type      StopType @default(BUS)

  /// External identifier (e.g. GTFS stop_id) for idempotent imports
  externalId String?

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  verified   Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeStops RouteStop[]
  reports    TransitReport[]
  favorites  Favorite[]

  @@index([cityId])
  @@index([areaId])
  @@index([latitude, longitude])
  @@index([externalId])
  @@fulltext([name, nameAr])
}

enum StopType {
  BUS
  MINIBUS
  TRAIN
  METRO
  TRAM
  BRT
  SHARED
  TAXI
}

model Route {
  id          String  @id @default(cuid())
  name        String
  nameAr      String
  nameEn      String?
  description String?

  transportModeId String
  transportMode   TransportMode @relation(fields: [transportModeId], references: [id])

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  fare          Float?
  fareType      FareType @default(FIXED)
  fareCurrency  String   @default("EGP")
  fareUpdatedAt DateTime?
  fareSource    String?

  status         RouteStatus @default(ACTIVE)
  operatingHours String? // e.g., "06:00-23:00"

  lastVerifiedAt  DateTime?
  confidenceLevel ConfidenceLevel @default(MEDIUM)
  dataSource      String?
  dataSourceUrl   String?

  /// External identifier (e.g. GTFS route_id) for idempotent imports
  externalId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  stops         RouteStop[]
  variants      RouteVariant[]
  reports       TransitReport[]
  dataUpdates   DataUpdate[]
  favorites     Favorite[]
  searchHistory SearchHistory[]

  @@index([cityId])
  @@index([transportModeId])
  @@index([status])
  @@index([lastVerifiedAt])
  @@index([externalId])
  @@fulltext([name, nameAr])
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  UNDER_REVIEW
  DRAFT
}

enum FareType {
  FIXED
  DISTANCE_BASED
  STAGE_BASED
  ZONE_BASED
}

enum ConfidenceLevel {
  HIGH // مصدر موثوق جدًا
  MEDIUM // تم التحقق
  LOW // تحتاج مراجعة
  UNVERIFIED // لم يتم التحقق
}

model RouteStop {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  stopId String
  stop   Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  order Int // ترتيب المحطة في الخط

  // Optional: belongs to a named variant of the route
  variantId String?
  variant   RouteVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  arrivalTime   String? // expected arrival time
  departureTime String?
  waitTime      Int? // في الدقائق

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, stopId, order])
  @@index([routeId])
  @@index([stopId])
}

model RouteVariant {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name        String // e.g., "شرقي - غربي"
  nameAr      String
  description String?

  stops RouteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId])
}

// ============= Data Quality & Updates =============
model DataSource {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  sourceType  DataSourceType
  url         String?

  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(IDLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates DataUpdate[]
}

enum DataSourceType {
  GOVERNMENT
  TRANSIT_COMPANY
  OSM
  GTFS
  MANUAL
  COMMUNITY
  EXTERNAL_API
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

model DataUpdate {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  sourceId String?
  source   DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  changeType  ChangeType
  description String
  before      Json? // تخزين البيانات القديمة
  after       Json? // تخزين البيانات الجديدة

  createdAt DateTime @default(now())

  @@index([routeId])
  @@index([sourceId])
  @@index([createdAt])
}

enum ChangeType {
  FARE_CHANGED
  HOURS_CHANGED
  STOPS_CHANGED
  ROUTE_CREATED
  ROUTE_DELETED
  ROUTE_MODIFIED
  STATUS_CHANGED
}

// ============= User Reports & Feedback =============
model TransitReport {
  id     String  @id @default(cuid())
  userId String? // nullable for anonymous reports
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reportType ReportType

  routeId String?
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)

  stopId String?
  stop   Stop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)

  description String
  details     Json?

  status   ReportStatus   @default(PENDING)
  priority ReportPriority @default(MEDIUM)

  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([routeId])
  @@index([stopId])
  @@index([status])
  @@index([createdAt])
}

enum ReportType {
  FARE_INCORRECT
  ROUTE_CLOSED
  ROUTE_CHANGED
  STOP_LOCATION_WRONG
  STOP_NAME_WRONG
  PICKUP_POINT_WRONG
  DROPOFF_POINT_WRONG
  OPERATING_HOURS_WRONG
  VEHICLE_NOT_AVAILABLE
  SAFETY_ISSUE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  RESOLVED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============= User Preferences =============
model Favorite {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type FavoriteType

  stopId String?
  stop   Stop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)

  routeId String?
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)

  label     String? // "البيت", "الشغل", etc
  latitude  Float?
  longitude Float?
  address   String?

  createdAt DateTime @default(now())

  @@unique([userId, type, label])
  @@index([userId])
}

enum FavoriteType {
  STOP
  ROUTE
  LOCATION
}

model SearchHistory {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromLat     Float?
  fromLng     Float?
  fromAddress String?

  toLat     Float?
  toLng     Float?
  toAddress String?

  routeId String?
  route   Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  searchMode SearchMode @default(FASTEST)

  resultCount  Int
  userSelected Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum SearchMode {
  FASTEST
  CHEAPEST
  FEWEST_TRANSFERS
  LEAST_WALKING
}

// ============= Admin =============
model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action       String
  resourceType String
  resourceId   String

  changes Json?
  before  Json?
  after   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([resourceType])
}

model SystemHealth {
  id String @id @default(cuid())

  routingService Boolean @default(true)
  database       Boolean @default(true)
  geocoding      Boolean @default(true)

  lastChecked DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
