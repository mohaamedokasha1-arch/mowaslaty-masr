# ============= Server =============
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# ============= Database =============
# Leave DATABASE_URL unset (or set DB_DRIVER=memory) to run on the built-in
# seeded in-memory database — great for local development and demos.
# For PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/mowaslaty_dev"
# DB_DRIVER=prisma

# ============= JWT =============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# ============= Admin bootstrap =============
ADMIN_EMAIL=admin@mowaslaty.com
ADMIN_PASSWORD=change-me-in-production

# ============= External services (optional) =============
OPENSTREETMAP_API_URL=https://nominatim.openstreetmap.org
# Set to "false" to disable online geocoding fallback (offline mode)
GEOCODING_ENABLED=true

# ============= CORS =============
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ============= Rate limiting =============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
